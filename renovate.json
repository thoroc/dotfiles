{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Version updates for the repo's pinned tools (mise.toml) and GitHub Actions. Dependabot keeps security alerts only.",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["mise", "github-actions"],
  "timezone": "Europe/London",
  "schedule": ["* 22-23 * * 0", "* 0-5 * * 1"],
  "automergeSchedule": ["* 22-23 * * 0", "* 0-5 * * 1"],
  "minimumReleaseAge": "30 days",
  "internalChecksFilter": "strict",
  "prHourlyLimit": 0,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "automergeSchedule": ["at any time"],
    "minimumReleaseAge": null,
    "automerge": false,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Bundle every minor, patch and digest update into one PR and merge it once CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "tooling (non-major)",
      "groupSlug": "tooling-non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates: own PR each, reviewed by hand",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "hk releases after 2.0.1 have no darwin/x86_64 build, and hk.pkl pins the 2.0.1 pkl schema",
      "matchManagers": ["mise"],
      "matchDepNames": ["hk"],
      "allowedVersions": "<=2.0.1"
    }
  ]
}
