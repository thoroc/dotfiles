{{- /* Per-machine answers: an optional, untracked TOML file (default ~/.config/chezmoi/init-defaults.toml, or $CHEZMOI_INIT_DEFAULTS). Its keys win over stored answers and skip the matching prompts. chezmoi init ignores --override-data-file for prompts, so it is merged into the data the prompt*Once calls read ($d). */ -}}
{{- $defaultsFile := or (env "CHEZMOI_INIT_DEFAULTS") (joinPath .chezmoi.homeDir ".config" "chezmoi" "init-defaults.toml") -}}
{{- $d := . -}}
{{- if stat $defaultsFile -}}
{{-   $d = mergeOverwrite (deepCopy .) (include $defaultsFile | fromToml) -}}
{{- end -}}

{{- $email            := promptStringOnce $d "user.work.email"   "Email address"                                                         "john.doe@example.com" -}}
{{- $username         := promptStringOnce $d "user.work.name"    "Username"                                                              "john.doe" -}}
{{- $projects_dir     := promptStringOnce $d "projects_dir"      "Work project directory (name of directory for the work projects)"      "acme" -}}
{{- $gh_email         := promptStringOnce $d "user.github.email" "GitHub email address"                                                  $email -}}
{{- $gh_username      := promptStringOnce $d "user.github.name"  "GitHub username"                                                       "john.doe" -}}
{{- $gh_projects_dir  := promptStringOnce $d "gh_projects_dir"   "GitHub project directory (name of directory for the GitHub projects)"  "github" -}}

{{- $os_shell := promptStringOnce $d "os_shell" "Enter your shell" "zsh"}}

{{- $darwin := eq .chezmoi.os "darwin" -}}

{{- /* Homebrew prefix (macOS only; Linux uses mise and apt, so it stays empty there) */ -}}
{{- $homebrew_prefix := "" -}}
{{- if not $darwin -}}
{{-   $homebrew_prefix = "" -}}
{{- else if eq .chezmoi.arch "amd64" -}}
{{-   $homebrew_prefix = "/usr/local" -}}
{{- else -}}
{{-   $homebrew_prefix = "/opt/homebrew" -}}
{{- end -}}

{{- /* Tools */ -}}
{{- $bat        := promptBoolOnce $d "tools.enable.bat"        "Enable bat as a cat replacement (y/n)"       true -}}
{{- $delta      := promptBoolOnce $d "tools.enable.delta"      "Enable delta as the git pager (Y/n)"         true -}}
{{- $nix        := promptBoolOnce $d "tools.enable.nix"        "Enable nix as a package manager (y/n)"       false -}}
{{- $one_drive  := false -}}
{{- if $darwin -}}
{{-   $one_drive = promptBoolOnce $d "tools.enable.one_drive" "Enable OneDrive autostart (y/n)" false -}}
{{- end -}}

{{- /* AI coding assistants: any combination, including none */ -}}
{{- $ai_claude   := promptBoolOnce $d "tools.ai.claude"   "Install Claude Code (y/N)" false -}}
{{- $ai_gemini   := promptBoolOnce $d "tools.ai.gemini"   "Install Gemini CLI (y/N)"  false -}}
{{- $ai_codex    := promptBoolOnce $d "tools.ai.codex"    "Install Codex CLI (y/N)"   false -}}
{{- $ai_opencode := promptBoolOnce $d "tools.ai.opencode" "Install opencode (y/N)"    false -}}

{{- /* Notes tools: any combination, including none */ -}}
{{- $notes_obsidian := promptBoolOnce $d "tools.notes.obsidian" "Use Obsidian for notes (y/N)" false -}}
{{- $notes_notion   := promptBoolOnce $d "tools.notes.notion"   "Use Notion for notes (y/N)"   false -}}
{{- $notes_logseq   := promptBoolOnce $d "tools.notes.logseq"   "Use Logseq for notes (y/N)"   false -}}
{{- $obsidian_vault := "" -}}
{{- if $notes_obsidian -}}
{{-   $obsidian_vault = promptStringOnce $d "tools.notes.obsidian_vault" "Obsidian vault path (absolute)" (printf "%s/Documents/obsidian-vault" .chezmoi.homeDir) -}}
{{- end -}}
{{- $logseq_graph := "" -}}
{{- if $notes_logseq -}}
{{-   $logseq_graph = promptStringOnce $d "tools.notes.logseq_graph" "Logseq graph path (absolute)" (printf "%s/Documents/logseq-graph" .chezmoi.homeDir) -}}
{{- end -}}

{{- /* Secrets on Linux: fnox uses an age key (macOS uses the keychain). Public recipient only; leave empty to skip the fnox config. The encrypted classic PAT (exported for brew and mise) may be set as secrets.github_token_age in init-defaults.toml (GitHub App keys: see github_app below). */ -}}
{{- $age_recipient := "" -}}
{{- if not $darwin -}}
{{-   $age_recipient = promptStringOnce $d "secrets.age_recipient" "age public key (recipient) for fnox secrets, empty to skip" "" -}}
{{- end -}}

{{- /* Shell prompt and ls replacement: one choice each ("none" keeps the shell default and installs nothing) */ -}}
{{- $prompt := promptChoiceOnce $d "tools.prompt" "Shell prompt" (list "oh-my-posh" "none") "oh-my-posh" -}}
{{- $ls     := promptChoiceOnce $d "tools.ls"     "ls replacement" (list "eza" "lsd" "none") "eza" -}}

{{- /* Terminal emulator: pick one ("terminal" is the built-in Terminal.app, nothing is installed for it) */ -}}
{{- /* Terminal, browser, editors and the container/LLM apps are macOS desktop apps installed with Homebrew casks: on Linux they are not asked about and stay "none"/empty. */ -}}
{{- $terminal := "none" -}}
{{- if $darwin -}}
{{-   $terminal = promptChoiceOnce $d "tools.terminal" "Terminal emulator" (list "iterm2" "warp" "alacritty" "kitty" "hyper" "wezterm" "terminal") "iterm2" -}}
{{- end -}}
{{- /* Primary web browser, pinned in the Dock next to the terminal. Independent of the install toggles below: it may be one that is already installed. */ -}}
{{- $browser := "none" -}}
{{- if $darwin -}}
{{-   $browser = promptChoiceOnce $d "tools.browser" "Primary browser (pinned in the Dock)" (list "safari" "brave" "firefox" "chrome" "edge") "safari" -}}
{{- end -}}

{{- /* Editors/IDEs: any combination; the value is the Homebrew cask name. VS Code only by default. */ -}}
{{- /* promptMultichoiceOnce ignores stored or overridden lists, so only prompt when no list is present */ -}}
{{- $editors := dig "tools" "editors" "" $d -}}
{{- if not (kindIs "slice" $editors) -}}
{{-   $editors = list -}}
{{- end -}}
{{- if and $darwin (not (kindIs "slice" (dig "tools" "editors" "" $d))) -}}
{{-   $editors = promptMultichoice "Editors/IDEs to install" (list "visual-studio-code" "zed" "cursor" "vscodium" "sublime-text" "webstorm" "intellij-idea" "pycharm") (list "visual-studio-code") -}}
{{- end -}}

{{- /* JavaScript package managers/runtimes (NodeJS itself is detected under lang): any combination, bun by default. Same stored-list rule as the editors. */ -}}
{{- $jsPm := dig "tools" "js_pm" "" $d -}}
{{- if not (kindIs "slice" $jsPm) -}}
{{-   $jsPm = promptMultichoice "JavaScript package managers/runtimes to install" (list "bun" "pnpm" "yarn" "deno") (list "bun") -}}
{{- end -}}

{{- /* Shells */ -}}

{{- /* Prompts */ -}}

{{- /* Editors */ -}}

{{- /* Lists */ -}}

{{- /* Languages. An installed language is enabled without asking and its source is detected from where it resolves
       on PATH ("mise", "brew", "rustup", "other"; the /usr/bin stubs count as not installed). For a Homebrew one the user
       may opt in to moving it to mise. "manager" is who owns installs: mise, brew, rustup, other or none. */ -}}
{{- $langSpecs := list
      (dict "key" "nodejs" "label" "NodeJS" "bin" "node"    "default" true)
      (dict "key" "python" "label" "Python" "bin" "python3" "default" true)
      (dict "key" "golang" "label" "Go"     "bin" "go"      "default" true)
      (dict "key" "rust"   "label" "Rust"   "bin" "rustc"   "default" true)
      (dict "key" "ruby"   "label" "Ruby"   "bin" "ruby"    "default" false)
      (dict "key" "java"   "label" "Java"   "bin" "java"    "default" false) -}}
{{- $lang := dict -}}
{{- range $langSpecs -}}
{{-   $spec := . -}}
{{-   $path := lookPath $spec.bin -}}
{{-   $source := "" -}}
{{-   if $path -}}
{{-     if contains "/.local/share/mise/" $path -}}
{{-       $source = "mise" -}}
{{-     else if or (contains "/usr/local/opt/" $path) (contains "/usr/local/Cellar/" $path) (contains "/opt/homebrew/" $path) -}}
{{-       $source = "brew" -}}
{{-     else if contains "/.cargo/" $path -}}
{{-       $source = "rustup" -}}
{{-     else if not (hasPrefix "/usr/bin/" $path) -}}
{{-       $source = "other" -}}
{{-     end -}}
{{-   end -}}
{{-   $enabled := dig "lang" $spec.key "enabled" "" $d -}}
{{-   if not (kindIs "bool" $enabled) -}}
{{-     if $source -}}
{{-       $enabled = true -}}
{{-     else -}}
{{-       $enabled = promptBool (printf "Enable %s as a programming language (%s)" $spec.label (ternary "Y/n" "y/N" $spec.default)) $spec.default -}}
{{-     end -}}
{{-   end -}}
{{-   $migrate := dig "lang" $spec.key "migrate" "" $d -}}
{{-   if not (kindIs "bool" $migrate) -}}
{{-     $migrate = false -}}
{{-     if and $enabled (eq $source "brew") -}}
{{-       $migrate = promptBool (printf "%s is installed with Homebrew. Move it to mise (installs it with mise, then removes the Homebrew formula unless something depends on it) (y/N)" $spec.label) false -}}
{{-     end -}}
{{-   end -}}
{{-   $manager := "none" -}}
{{-   if $enabled -}}
{{-     if or (eq $source "") (eq $source "mise") $migrate -}}
{{-       $manager = "mise" -}}
{{-     else -}}
{{-       $manager = $source -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set $lang $spec.key (dict "enabled" $enabled "source" $source "migrate" $migrate "manager" $manager) -}}
{{- end -}}

{{- /* Version managers and helpers: already present means enabled, otherwise ask only when the language is enabled */ -}}
{{- $helpers := list (list "python" "poetry" "poetry" "Poetry as a Python package manager") (list "python" "pyenv" "pyenv" "pyenv as a Python version manager") (list "java" "jenv" "jenv" "jenv as a Java version manager") -}}
{{- range $helpers -}}
{{-   $parent := index . 0 -}}
{{-   $name := index . 1 -}}
{{-   $bin := index . 2 -}}
{{-   $text := index . 3 -}}
{{-   $parentKey := ternary "python" "java" (eq $parent "python") -}}
{{-   $value := dig "lang" $parentKey $name "" $d -}}
{{-   if not (kindIs "bool" $value) -}}
{{-     $value = false -}}
{{-     if (index $lang $parentKey).enabled -}}
{{-       if lookPath $bin -}}
{{-         $value = true -}}
{{-       else -}}
{{-         $value = promptBool (printf "Enable %s (y/N)" $text) false -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set (index $lang $parentKey) $name $value -}}
{{- end -}}

{{- /* Homebrew tools that mise can provide as prebuilt binaries (checked on darwin/amd64): offer to move the ones that are installed. ffmpeg, make and poppler are deliberately left out (mise builds or repackages them). */ -}}
{{- $movable := list "d2" "mas" -}}
{{- $moveChosen := dig "tools" "migrate_to_mise" "" $d -}}
{{- if not (kindIs "slice" $moveChosen) -}}
{{-   $moveChosen = list -}}
{{-   if lookPath "brew" -}}
{{-     $installed := splitList "\n" (output "brew" "list" "--formula" "-1" | trim) -}}
{{-     $candidates := list -}}
{{-     range $movable -}}
{{-       if has . $installed -}}
{{-         $candidates = append $candidates . -}}
{{-       end -}}
{{-     end -}}
{{-     if $candidates -}}
{{-       $moveChosen = promptMultichoice "Homebrew tools to move to mise (installs with mise, then removes the formula)" $candidates (list) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* Local LLM runners: any combination, none by default. One that is already installed is enabled without asking. LM Studio only ships for Apple Silicon. */ -}}
{{- $llmSpecs := list (list "ollama" "Ollama.app") (list "jan" "Jan.app") (list "msty" "Msty.app") -}}
{{- if eq .chezmoi.arch "arm64" -}}
{{-   $llmSpecs = append $llmSpecs (list "lm-studio" "LM Studio.app") -}}
{{- end -}}
{{- $llm := dig "tools" "llm" "" $d -}}
{{- if not (kindIs "slice" $llm) -}}
{{-   $llm = list -}}
{{-   $llmAsk := list -}}
{{-   if not $darwin -}}
{{-     $llmSpecs = list -}}
{{-   end -}}
{{-   range $llmSpecs -}}
{{-     if stat (printf "/Applications/%s" (index . 1)) -}}
{{-       $llm = append $llm (index . 0) -}}
{{-     else -}}
{{-       $llmAsk = append $llmAsk (index . 0) -}}
{{-     end -}}
{{-   end -}}
{{-   if $llmAsk -}}
{{-     $llm = concat $llm (promptMultichoice "Local LLM runners to install (none by default)" $llmAsk (list)) -}}
{{-   end -}}
{{- end -}}

{{- $instal_brave := false -}}
{{- $instal_firefox := false -}}
{{- $instal_chrome := false -}}
{{- $instal_edge := false -}}
{{- if $darwin -}}
{{-   $instal_brave   = promptBoolOnce $d "tools.install.browser.brave"   "Install Brave browser (Y/n)"   false -}}
{{-   $instal_firefox = promptBoolOnce $d "tools.install.browser.firefox" "Install Firefox browser (Y/n)" true -}}
{{-   $instal_chrome  = promptBoolOnce $d "tools.install.browser.chrome"  "Install Chrome browser (Y/n)"  true -}}
{{-   $instal_edge    = promptBoolOnce $d "tools.install.browser.edge"    "Install Edge browser (Y/n)"    false -}}
{{- end -}}

{{- /* Container runtime: exactly one of Docker Desktop, OrbStack or Colima (or none). A stored or defaults-file answer wins. Otherwise an installed runtime is used without asking; if several are installed, ask which one; if none is, ask with Docker Desktop as the default. */ -}}
{{- $container := dig "tools" "container" "" $d -}}
{{- if not (kindIs "string" $container) -}}
{{-   $container = "" -}}
{{- end -}}
{{- if not $container -}}
{{-   $found := list -}}
{{-   if or (and $darwin (stat "/Applications/Docker.app")) (and (not $darwin) (lookPath "docker")) -}}
{{-     $found = append $found "docker" -}}
{{-   end -}}
{{-   if and $darwin (stat "/Applications/OrbStack.app") -}}
{{-     $found = append $found "orbstack" -}}
{{-   end -}}
{{-   if lookPath "colima" -}}
{{-     $found = append $found "colima" -}}
{{-   end -}}
{{-   if eq (len $found) 1 -}}
{{-     $container = index $found 0 -}}
{{-   else if $found -}}
{{-     $container = promptChoice "Several container runtimes are installed. Which one do you use" $found (index $found 0) -}}
{{-   else if $darwin -}}
{{-     $container = promptChoice "Container runtime" (list "docker" "orbstack" "colima" "none") "docker" -}}
{{-   else -}}
{{-     $container = promptChoice "Container runtime (not installed by this repo on Linux)" (list "docker" "colima" "none") "none" -}}
{{-   end -}}
{{- end -}}

sourceDir = "{{ .chezmoi.homeDir }}/.dotfiles"

[data]
os_shell = "/bin/{{ base $os_shell }}"
homebrew_prefix = {{ $homebrew_prefix | quote }}
projects_dir = {{ $projects_dir | quote }}
gh_projects_dir = {{ $gh_projects_dir | quote }}

[data.user.work]
name = {{ $username | quote }}
email = {{ $email | quote }}

[data.user.github]
name = {{ $gh_username | quote }}
email = {{ $gh_email | quote }}

[data.tools]
# one of "oh-my-posh" or "none"
prompt = {{ $prompt | quote }}
# one of "iterm2", "warp", "alacritty", "kitty", "hyper", "wezterm" or "terminal" (built-in Terminal.app); "none" on Linux
terminal = {{ $terminal | quote }}
# primary browser pinned in the Dock: one of "safari", "brave", "firefox", "chrome" or "edge"
browser = {{ $browser | quote }}
# container runtime: "docker", "orbstack", "colima" or "none" (the booleans under install.container are derived from it)
container = {{ $container | quote }}
# editors/IDEs to install, by Homebrew cask name (see the "Editors/IDEs" prompt)
editors = {{ $editors | toJson }}
# JavaScript package managers/runtimes installed with mise: any of "bun", "pnpm", "yarn", "deno"
js_pm = {{ $jsPm | toJson }}
# Homebrew tools to move to mise; consumed by the mise config and the migration script
migrate_to_mise = {{ $moveChosen | toJson }}
# local LLM runners to install (ollama, jan, msty, lm-studio on Apple Silicon)
llm = {{ $llm | toJson }}
# one of "eza", "lsd" or "none"
ls = {{ $ls | quote }}

{{- if not $darwin }}

[data.secrets]
age_recipient = {{ $age_recipient | quote }}
{{- with dig "secrets" "github_token_age" "" $d }}
github_token_age = {{ . | quote }}
{{- end }}
{{- end }}

{{- /* GitHub Apps for fnox `github-app` leases (no prompt; set in init-defaults.toml). One entry per installation, each naming its own app: `user` for the personal account, `orgs.<org>` per org. app_id and installation_id are not secret; the private key is in the keychain (macOS) or the entry's age ciphertext `key_age` (Linux). An entry missing either id is dropped. */ -}}
{{- $apps := list -}}
{{- with dig "github_app" "user" (dict) $d -}}
{{-   if and (get . "app_id") (get . "installation_id") -}}
{{-     $apps = append $apps (list "data.github_app.user" .) -}}
{{-   end -}}
{{- end -}}
{{- range $org, $app := dig "github_app" "orgs" (dict) $d -}}
{{-   if and (get $app "app_id") (get $app "installation_id") -}}
{{-     $apps = append $apps (list (printf "data.github_app.orgs.%s" ($org | quote)) $app) -}}
{{-   end -}}
{{- end -}}
{{- range $apps }}
{{- $app := index . 1 }}

[{{ index . 0 }}]
app_id = {{ (get $app "app_id") | toString | quote }}
installation_id = {{ (get $app "installation_id") | toString | quote }}
{{- with (get $app "key_age") }}
key_age = {{ . | quote }}
{{- end }}
{{- end }}

[data.tools.ai]
claude = {{ $ai_claude }}
gemini = {{ $ai_gemini }}
codex = {{ $ai_codex }}
opencode = {{ $ai_opencode }}

[data.tools.notes]
obsidian = {{ $notes_obsidian }}
notion = {{ $notes_notion }}
logseq = {{ $notes_logseq }}
{{- if $notes_obsidian }}
obsidian_vault = {{ $obsidian_vault | quote }}
{{- end }}
{{- if $notes_logseq }}
logseq_graph = {{ $logseq_graph | quote }}
{{- end }}

[data.tools.install.browser]
brave = {{ $instal_brave }}
firefox = {{ $instal_firefox }}
chrome = {{ $instal_chrome }}
edge = {{ $instal_edge }}

[data.tools.install.container]
docker = {{ eq $container "docker" }}
orbstack = {{ eq $container "orbstack" }}
colima = {{ eq $container "colima" }}

[data.tools.enable]
bat = {{ $bat }}
delta = {{ $delta }}
nix = {{ $nix }}
one_drive = {{ $one_drive }}

{{ range $k, $v := $lang }}
[data.lang.{{ $k }}]
{{- range $f, $val := $v }}
{{ $f }} = {{ if kindIs "string" $val }}{{ $val | quote }}{{ else }}{{ $val }}{{ end }}
{{- end }}
{{ end -}}
