{{- /* Per-machine answers: an optional, untracked TOML file (default ~/.config/chezmoi/init-defaults.toml, or $CHEZMOI_INIT_DEFAULTS). Its keys win over stored answers and skip the matching prompts. chezmoi init ignores --override-data-file for prompts, so it is merged into the data the prompt*Once calls read ($d). */ -}}
{{- $defaultsFile := or (env "CHEZMOI_INIT_DEFAULTS") (joinPath .chezmoi.homeDir ".config" "chezmoi" "init-defaults.toml") -}}
{{- $d := . -}}
{{- if stat $defaultsFile -}}
{{-   $d = mergeOverwrite (deepCopy .) (include $defaultsFile | fromToml) -}}
{{- end -}}

{{- $email            := promptStringOnce $d "user.work.email"   "Email address"                                                         "john.doe@example.com" -}}
{{- $username         := promptStringOnce $d "user.work.name"    "Username"                                                              "john.doe" -}}
{{- $projects_dir     := promptStringOnce $d "projects_dir"      "Work project directory (name of directory for the work projects)"      "acme" -}}
{{- $gh_email         := promptStringOnce $d "user.github.email" "GitHub email address"                                                  $email -}}
{{- $gh_username      := promptStringOnce $d "user.github.name"  "GitHub username"                                                       "john.doe" -}}
{{- $gh_projects_dir  := promptStringOnce $d "gh_projects_dir"   "GitHub project directory (name of directory for the GitHub projects)"  "github" -}}

{{- $os_shell := promptStringOnce $d "os_shell" "Enter your shell" "zsh"}}

{{- /* Homebrew prefix */ -}}
{{- $homebrew_prefix := "" -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{-   $homebrew_prefix = "/usr/local" -}}
{{- else -}}
{{-   $homebrew_prefix = "/opt/homebrew" -}}
{{- end -}}

{{- /* Tools */ -}}
{{- $bat        := promptBoolOnce $d "tools.enable.bat"        "Enable bat as a cat replacement (y/n)"       true -}}
{{- $nix        := promptBoolOnce $d "tools.enable.nix"        "Enable nix as a package manager (y/n)"       false -}}
{{- $one_drive  := promptBoolOnce $d "tools.enable.one_drive"  "Enable OneDrive autostart (y/n)"             false -}}

{{- /* AI coding assistants: any combination, including none */ -}}
{{- $ai_claude   := promptBoolOnce $d "tools.ai.claude"   "Install Claude Code (y/N)" false -}}
{{- $ai_gemini   := promptBoolOnce $d "tools.ai.gemini"   "Install Gemini CLI (y/N)"  false -}}
{{- $ai_codex    := promptBoolOnce $d "tools.ai.codex"    "Install Codex CLI (y/N)"   false -}}
{{- $ai_opencode := promptBoolOnce $d "tools.ai.opencode" "Install opencode (y/N)"    false -}}

{{- /* Notes tools: any combination, including none */ -}}
{{- $notes_obsidian := promptBoolOnce $d "tools.notes.obsidian" "Use Obsidian for notes (y/N)" false -}}
{{- $notes_notion   := promptBoolOnce $d "tools.notes.notion"   "Use Notion for notes (y/N)"   false -}}
{{- $notes_logseq   := promptBoolOnce $d "tools.notes.logseq"   "Use Logseq for notes (y/N)"   false -}}
{{- $obsidian_vault := "" -}}
{{- if $notes_obsidian -}}
{{-   $obsidian_vault = promptStringOnce $d "tools.notes.obsidian_vault" "Obsidian vault path (absolute)" (printf "%s/Documents/obsidian-vault" .chezmoi.homeDir) -}}
{{- end -}}
{{- $logseq_graph := "" -}}
{{- if $notes_logseq -}}
{{-   $logseq_graph = promptStringOnce $d "tools.notes.logseq_graph" "Logseq graph path (absolute)" (printf "%s/Documents/logseq-graph" .chezmoi.homeDir) -}}
{{- end -}}

{{- /* Shell prompt and ls replacement: one choice each ("none" keeps the shell default and installs nothing) */ -}}
{{- $prompt := promptChoiceOnce $d "tools.prompt" "Shell prompt" (list "oh-my-posh" "none") "oh-my-posh" -}}
{{- $ls     := promptChoiceOnce $d "tools.ls"     "ls replacement" (list "eza" "lsd" "none") "eza" -}}

{{- /* Terminal emulator: pick one ("terminal" is the built-in Terminal.app, nothing is installed for it) */ -}}
{{- $terminal := promptChoiceOnce $d "tools.terminal" "Terminal emulator" (list "iterm2" "warp" "alacritty" "kitty" "hyper" "wezterm" "terminal") "iterm2" -}}

{{- /* Editors/IDEs: any combination; the value is the Homebrew cask name. VS Code only by default. */ -}}
{{- /* promptMultichoiceOnce ignores stored or overridden lists, so only prompt when no list is present */ -}}
{{- $editors := dig "tools" "editors" "" $d -}}
{{- if not (kindIs "slice" $editors) -}}
{{-   $editors = promptMultichoice "Editors/IDEs to install" (list "visual-studio-code" "zed" "cursor" "vscodium" "sublime-text" "webstorm" "intellij-idea" "pycharm") (list "visual-studio-code") -}}
{{- end -}}

{{- /* Shells */ -}}

{{- /* Prompts */ -}}

{{- /* Editors */ -}}

{{- /* Lists */ -}}

{{- /* Languages. An installed language is enabled without asking and its source is detected from where it resolves
       on PATH ("mise", "brew", "rustup", "other"; the /usr/bin stubs count as not installed). For a Homebrew one the user
       may opt in to moving it to mise. "manager" is who owns installs: mise, brew, rustup, other or none. */ -}}
{{- $langSpecs := list
      (dict "key" "nodejs" "label" "NodeJS" "bin" "node"    "default" true)
      (dict "key" "python" "label" "Python" "bin" "python3" "default" true)
      (dict "key" "golang" "label" "Go"     "bin" "go"      "default" true)
      (dict "key" "rust"   "label" "Rust"   "bin" "rustc"   "default" true)
      (dict "key" "java"   "label" "Java"   "bin" "java"    "default" false) -}}
{{- $lang := dict -}}
{{- range $langSpecs -}}
{{-   $spec := . -}}
{{-   $path := lookPath $spec.bin -}}
{{-   $source := "" -}}
{{-   if $path -}}
{{-     if contains "/.local/share/mise/" $path -}}
{{-       $source = "mise" -}}
{{-     else if or (contains "/usr/local/opt/" $path) (contains "/usr/local/Cellar/" $path) (contains "/opt/homebrew/" $path) -}}
{{-       $source = "brew" -}}
{{-     else if contains "/.cargo/" $path -}}
{{-       $source = "rustup" -}}
{{-     else if not (hasPrefix "/usr/bin/" $path) -}}
{{-       $source = "other" -}}
{{-     end -}}
{{-   end -}}
{{-   $enabled := dig "lang" $spec.key "enabled" "" $d -}}
{{-   if not (kindIs "bool" $enabled) -}}
{{-     if $source -}}
{{-       $enabled = true -}}
{{-     else -}}
{{-       $enabled = promptBool (printf "Enable %s as a programming language (%s)" $spec.label (ternary "Y/n" "y/N" $spec.default)) $spec.default -}}
{{-     end -}}
{{-   end -}}
{{-   $migrate := dig "lang" $spec.key "migrate" "" $d -}}
{{-   if not (kindIs "bool" $migrate) -}}
{{-     $migrate = false -}}
{{-     if and $enabled (eq $source "brew") -}}
{{-       $migrate = promptBool (printf "%s is installed with Homebrew. Move it to mise (installs it with mise, then removes the Homebrew formula unless something depends on it) (y/N)" $spec.label) false -}}
{{-     end -}}
{{-   end -}}
{{-   $manager := "none" -}}
{{-   if $enabled -}}
{{-     if or (eq $source "") (eq $source "mise") $migrate -}}
{{-       $manager = "mise" -}}
{{-     else -}}
{{-       $manager = $source -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set $lang $spec.key (dict "enabled" $enabled "source" $source "migrate" $migrate "manager" $manager) -}}
{{- end -}}

{{- /* Version managers and helpers: already present means enabled, otherwise ask only when the language is enabled */ -}}
{{- $helpers := list (list "python" "poetry" "poetry" "Poetry as a Python package manager") (list "python" "pyenv" "pyenv" "pyenv as a Python version manager") (list "java" "jenv" "jenv" "jenv as a Java version manager") -}}
{{- range $helpers -}}
{{-   $parent := index . 0 -}}
{{-   $name := index . 1 -}}
{{-   $bin := index . 2 -}}
{{-   $text := index . 3 -}}
{{-   $parentKey := ternary "python" "java" (eq $parent "python") -}}
{{-   $value := dig "lang" $parentKey $name "" $d -}}
{{-   if not (kindIs "bool" $value) -}}
{{-     $value = false -}}
{{-     if (index $lang $parentKey).enabled -}}
{{-       if lookPath $bin -}}
{{-         $value = true -}}
{{-       else -}}
{{-         $value = promptBool (printf "Enable %s (y/N)" $text) false -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set (index $lang $parentKey) $name $value -}}
{{- end -}}

{{- $instal_brave     := promptBoolOnce $d "tools.install.browser.brave"     "Install Brave browser (Y/n)"     false -}}
{{- $instal_firefox   := promptBoolOnce $d "tools.install.browser.firefox"   "Install Firefox browser (Y/n)"   true -}}
{{- $instal_chrome    := promptBoolOnce $d "tools.install.browser.chrome"    "Install Chrome browser (Y/n)"    true -}}
{{- $instal_edge      := promptBoolOnce $d "tools.install.browser.edge"      "Install Edge browser (Y/n)"      false -}}

{{- /* Container runtimes: either, both or neither */ -}}
{{- /* An app that is already installed is simply enabled, without asking */ -}}
{{- $install_docker := dig "tools" "install" "container" "docker" "" $d -}}
{{- if not (kindIs "bool" $install_docker) -}}
{{-   if stat "/Applications/Docker.app" -}}
{{-     $install_docker = true -}}
{{-   else -}}
{{-     $install_docker = promptBool "Install Docker Desktop (Y/n)" true -}}
{{-   end -}}
{{- end -}}
{{- $install_orbstack := dig "tools" "install" "container" "orbstack" "" $d -}}
{{- if not (kindIs "bool" $install_orbstack) -}}
{{-   if stat "/Applications/OrbStack.app" -}}
{{-     $install_orbstack = true -}}
{{-   else -}}
{{-     $install_orbstack = promptBool "Install OrbStack (y/N)" false -}}
{{-   end -}}
{{- end -}}

sourceDir = "{{ .chezmoi.homeDir }}/.dotfiles"

[data]
os_shell = "/bin/{{ $os_shell }}"
homebrew_prefix = {{ $homebrew_prefix | quote }}
projects_dir = {{ $projects_dir | quote }}
gh_projects_dir = {{ $gh_projects_dir | quote }}

[data.user.work]
name = {{ $username | quote }}
email = {{ $email | quote }}

[data.user.github]
name = {{ $gh_username | quote }}
email = {{ $gh_email | quote }}

[data.tools]
# one of "oh-my-posh" or "none"
prompt = {{ $prompt | quote }}
# one of "iterm2", "warp", "alacritty", "kitty", "hyper", "wezterm" or "terminal" (built-in Terminal.app)
terminal = {{ $terminal | quote }}
# editors/IDEs to install, by Homebrew cask name (see the "Editors/IDEs" prompt)
editors = {{ $editors | toJson }}
# one of "eza", "lsd" or "none"
ls = {{ $ls | quote }}

[data.tools.ai]
claude = {{ $ai_claude }}
gemini = {{ $ai_gemini }}
codex = {{ $ai_codex }}
opencode = {{ $ai_opencode }}

[data.tools.notes]
obsidian = {{ $notes_obsidian }}
notion = {{ $notes_notion }}
logseq = {{ $notes_logseq }}
{{- if $notes_obsidian }}
obsidian_vault = {{ $obsidian_vault | quote }}
{{- end }}
{{- if $notes_logseq }}
logseq_graph = {{ $logseq_graph | quote }}
{{- end }}

[data.tools.install.browser]
brave = {{ $instal_brave }}
firefox = {{ $instal_firefox }}
chrome = {{ $instal_chrome }}
edge = {{ $instal_edge }}

[data.tools.install.container]
docker = {{ $install_docker }}
orbstack = {{ $install_orbstack }}

[data.tools.enable]
bat = {{ $bat }}
nix = {{ $nix }}
one_drive = {{ $one_drive }}

{{ range $k, $v := $lang }}
[data.lang.{{ $k }}]
{{- range $f, $val := $v }}
{{ $f }} = {{ if kindIs "string" $val }}{{ $val | quote }}{{ else }}{{ $val }}{{ end }}
{{- end }}
{{ end -}}
