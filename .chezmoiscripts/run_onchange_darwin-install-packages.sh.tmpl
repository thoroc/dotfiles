{{ if eq .chezmoi.os "darwin" -}}
#!{{ .os_shell }}

eval "$({{ .homebrew_prefix }}/bin/brew shellenv)"

brew bundle --file=/dev/stdin <<EOF
{{ if eq .tools.install.browser.brave true }}
cask "brave-browser"
{{ end }}
{{ if eq .tools.install.browser.firefox true }}
cask "firefox"
{{ end }}
{{ if eq .tools.install.browser.chrome true }}
cask "google-chrome"
{{ end }}
{{ if eq .tools.install.browser.edge true }}
cask "microsoft-edge"
{{ end }}
{{ if eq .lang.java.jenv true }}
brew "jenv"
{{ end }}
{{ if eq .tools.install.container.docker true }}
cask "docker"
{{ end }}
{{ if eq .tools.install.container.orbstack true }}
cask "orbstack"
{{ end }}
{{ if and (hasKey .tools "terminal") (ne .tools.terminal "terminal") }}
cask {{ .tools.terminal | quote }}
{{ end }}
{{ range (dig "tools" "editors" (list "visual-studio-code") .) }}
cask {{ . | quote }}
{{ end }}
{{ if eq .chezmoi.arch "amd64" }}
brew "git-delta"
{{ end }}
{{ if eq (dig "lang" "java" "manager" (ternary "brew" "none" .lang.java.enabled) .) "brew" }}
brew "openjdk@11"
brew "openjdk@8"
{{ end }}
EOF

# AI assistants that ship their own installers: only install when missing, so an existing install is left alone
{{ if dig "tools" "ai" "claude" false . -}}
command -v claude >/dev/null 2>&1 || brew install --cask claude-code
{{ end -}}
{{ if dig "tools" "ai" "opencode" false . -}}
command -v opencode >/dev/null 2>&1 || brew install opencode
{{ end -}}
{{ end -}}
