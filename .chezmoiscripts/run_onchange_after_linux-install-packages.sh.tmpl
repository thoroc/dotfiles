{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# System basics with apt, then every CLI with mise (the list lives in dot_config/mise/config.toml.tmpl).
# "after": chezmoi must have written ~/.config/mise/config.toml before `mise install` runs.
# Re-runs when this script or the mise config changes.
# mise config: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
set -euo pipefail

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  SUDO="sudo"
fi

if command -v apt-get >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  $SUDO apt-get update
  $SUDO apt-get install -y --no-install-recommends zsh git curl ca-certificates build-essential unzip
  # age backs the fnox secrets provider on Linux; not packaged on older releases, so do not fail the apply over it
  $SUDO apt-get install -y --no-install-recommends age || echo "warning: age is not available from apt, install it by hand" >&2
else
  echo "warning: apt-get not found. Only Debian/Ubuntu are handled: install zsh, git, curl, a C toolchain and age yourself." >&2
fi

export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null 2>&1; then
  curl -fsSL https://mise.run | sh
fi

mise install --yes
{{ end -}}
