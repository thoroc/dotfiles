#!/bin/bash
# Inject Obsidian vault context before code-related tool use.
# Claude Code passes JSON on stdin: {"tool_name": "...", "tool_input": {...}, ...}

TOOL_INPUT=$(cat)
TOOL_NAME=$(echo "$TOOL_INPUT" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(d.get('tool_name', ''))
" 2>/dev/null)

case "$TOOL_NAME" in
    Edit|Write|Bash)
        QUERY=$(echo "$TOOL_INPUT" | python3 -c "
import sys, json
d = json.load(sys.stdin)
inp = d.get('tool_input', {})
q = inp.get('description') or inp.get('file_path') or inp.get('command') or ''
print(str(q)[:200])
" 2>/dev/null)

        if [ -n "$QUERY" ]; then
            CONTEXT=$(
                VAULT_PATH="{{ .tools.notes.obsidian_vault }}" \
                DB_PATH="$HOME/.claude/obsidian/vectors.db" \
                "$HOME/.claude/venvs/memory/bin/python" \
                "$HOME/.claude/obsidian/retriever.py" \
                search "$QUERY" --limit 3 --max-tokens 1500 2>/dev/null
            )
            if [ -n "$CONTEXT" ] && [ "$CONTEXT" != "No results found." ]; then
                echo "---"
                echo "Obsidian vault context:"
                echo "$CONTEXT"
                echo "---"
            fi
        fi
        ;;
esac

exit 0
