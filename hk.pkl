amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

steps {
    // Scans the staged diff (every file type) for secrets before it can be committed
    ["secrets"] {
        check = "gitleaks git --pre-commit --staged --redact --no-banner --verbose"
    }
    ["format-docs"] {
        glob = "*.md"
        // dot_claude/ holds verbatim copies of files applied to ~/.claude
        exclude = "dot_claude/**"
        fix = "prettier --write --prose-wrap always {{ files }}"
        check = "prettier --check --prose-wrap always {{ files }}"
    }
    ["lint-docs"] {
        glob = "*.md"
        exclude = "dot_claude/**"
        fix = "rumdl check --fix {{ files }}"
        check = "rumdl check {{ files }}"
    }
    ["markdown-toc"] {
        glob = "*.md"
        // CLAUDE.md must start with its own heading, not a generated TOC
        exclude = new Listing { "CLAUDE.md"; "dot_claude/**" }
        fix = "doctoc {{ files }}"
    }
}
