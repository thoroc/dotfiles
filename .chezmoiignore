# Obsidian integration (MCP server, hooks) only when Obsidian is enabled
{{ if not (dig "tools" "notes" "obsidian" false .) -}}
.config/claude/obsidian
.config/claude/hooks/pre-tool-use/obsidian-context.sh
.config/claude/hooks/post-tool-use/capture-insight.sh
