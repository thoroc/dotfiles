[tools]
"github:cli/cli" = "latest"
{{ range (dig "tools" "migrate_to_mise" (list) .) -}}
{{ . | quote }} = "latest"
{{ end -}}
{{ if eq (dig "tools" "prompt" "oh-my-posh" .) "oh-my-posh" -}}
"github:JanDeDobbeleer/oh-my-posh" = "latest"
"github:thoroc/git-mirror" = "latest"
{{ end -}}
"github:DeusData/codebase-memory-mcp" = "latest"
"github:golangci/golangci-lint" = "latest"
"github:jmespath/jp" = "latest"
"github:mike-engel/jwt-cli" = "latest"
"github:minamijoyo/hcledit" = "latest"
"github:orhun/git-cliff" = "latest"
"github:TylerBrock/saw" = "latest"
"npm:@dotenvx/dotenvx" = "latest"
{{ if dig "tools" "ai" "gemini" false . -}}
"npm:@google/gemini-cli" = "latest"
{{ end -}}
{{ if dig "tools" "ai" "codex" false . -}}
"npm:@openai/codex" = "latest"
{{ end -}}
"npm:@tobilu/qmd" = "latest"
"npm:aislop" = "latest"
"npm:cgx" = "latest"
"npm:context-mode" = "latest"
"npm:generator-code" = "latest"
"npm:gitlab-ci-local" = "latest"
"npm:npm" = "latest"
"npm:osgrep" = "latest"
"pipx:thefuck" = "latest"
"pipx:virtualenv" = "latest"
act = "latest"
ansible = "latest"
aws-cli = "latest"
aws-sam-cli = "latest"
azure-cli = "latest"
bat = "latest"
bun = "latest"
caddy = "latest"
cfn-lint = "latest"
chezmoi = "latest"
dive = "latest"
docker-compose = "latest"
duckdb = "latest"
{{ if eq (dig "tools" "ls" "eza" .) "eza" -}}
eza = "latest"
{{ end -}}
fd = "latest"
fnox = "latest"
fzf = "latest"
{{ if eq (dig "lang" "golang" "manager" "mise" .) "mise" -}}
go = "1.24"
{{ end -}}
{{ if eq (dig "lang" "java" "manager" "mise" .) "mise" -}}
java = "openjdk-11"
{{ end -}}
jq = "latest"
{{ if eq (dig "tools" "ls" "eza" .) "lsd" -}}
lsd = "latest"
{{ end -}}
{{ if eq (dig "lang" "nodejs" "manager" "mise" .) "mise" -}}
node = "latest"
{{ end -}}
perl = "latest"
pipx = "latest"
pnpm = "latest"
prettier = "latest"
protobuf = "latest"
{{ if eq (dig "lang" "python" "manager" "mise" .) "mise" -}}
python = "3.13"
{{ end -}}
ripgrep = "latest"
{{ if ne .chezmoi.arch "amd64" -}}
delta = "latest"
{{ end -}}
{{ else -}}
{{- /* no prebuilt delta for darwin/amd64: compile it with cargo. Pinned (not "latest") so mise only recompiles when this version is bumped by hand; bump it deliberately. Needs a Rust toolchain, see the rust block below. */ -}}
"cargo:git-delta" = "0.21.2"
rlwrap = "latest"
rumdl = "latest"
{{/* Intel builds delta from source, so a toolchain is required: mise installs one when no other manager (rustup, brew, other) provides rustc */ -}}
{{ $rustManager := dig "lang" "rust" "manager" "mise" . -}}
{{ if or (eq $rustManager "mise") (and (eq .chezmoi.arch "amd64") (eq $rustManager "none")) -}}
rust = "latest"
{{ end -}}
semgrep = "latest"
sqlite = "latest"
terraform = "latest"
terraform-docs = "latest"
terraformer = "latest"
terragrunt = "latest"
terrascan = "latest"
tflint = "latest"
tfsec = "latest"
tfupdate = "latest"
tree-sitter = "latest"
uv = "latest"
vim = "latest"
watchexec = "latest"
xh = "latest"
yq = "latest"
zoxide = "latest"

[settings]
idiomatic_version_file_enable_tools = ["node", "python", "rust", "terraform"]
experimental = true
minimum_release_age = "7d"
# hk is the git hook runner for the dotfiles repo (mise.toml); install its newest release without waiting out the cooloff
minimum_release_age_excludes = ["hk"]
