# AWS 
# ---------------------------------------------------------------------------------------------------------------------
export AWS_SDK_LOAD_CONFIG=1
export AWS_CONFIG_FILE=/Users/thomas.roche/.aws/config
export AWS_SHARED_CREDENTIALS_FILE=/Users/thomas.roche/.aws/credentials


# declare the AWS_PROFILE var
export AWS_PROFILE

okta() {
    # Argument is the okta profile name, defined in ~/.okta-aws (e.g. tooling)
    if [ ! -f/Users/thomas.roche/.okta-aws ];then
      echo "Missing/Users/thomas.roche/.okta-aws, please set it up."
      return 1
    elif [ -z "$1" ]; then
      echo "Missing profile argument, please provide one of the following:"
      cat "/Users/thomas.roche/.okta-aws" | sed -n 's/^\[/  * /p' | tr -d '\]' | sort
      return 1
    else
        unset AWS_PROFILE
        okta-awscli -f --okta-profile "${1}" --profile "${1}"
        export AWS_PROFILE=$1
        echo "AWS_PROFILE set to \"$1\"."
    fi
}


